{
  "name": "ng-matrix",
  "version": "0.1.0",
  "description": "Find out which Angular versions your published library really works with: it installs the packed package into a fresh app for each Angular major, builds it, and reports a matrix.",
  "keywords": [
    "angular",
    "library",
    "compatibility",
    "peer-dependencies",
    "ng-packagr",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berserker5619/ng-matrix.git"
  },
  "bugs": "https://github.com/berserker5619/ng-matrix/issues",
  "homepage": "https://github.com/berserker5619/ng-matrix#readme",
  "license": "MIT",
  "author": "Nizamudeen S",
  "type": "module",
  "bin": {
    "ng-matrix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:fixtures": "node test/fixtures/run.ts",
    "record-registry": "node scripts/record-registry.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "tar": "^7.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "~5.9.3"
  }
}
